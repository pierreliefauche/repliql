{
  "name": "@repliql/playground",
  "version": "0.0.1",
  "description": "Web application to test RepliQL packages",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.html",
    "build": "bun build ./src/index.tsx --outdir ./dist --entry-naming [name].[ext] --minify",
    "preview": "bun serve ./dist",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src"
  },
  "dependencies": {
    "@repliql/repliql": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bun-types": "latest",
    "typescript": "^6.0.0"
  }
}
