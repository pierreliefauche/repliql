/**
 * Bun Configuration for @repliql/playground
 * Web application - configured for development server and browser builds
 */
{
  // Development server configuration
  "dev": {
    // Listen on all network interfaces for remote access
    "host": "0.0.0.0",
    // Server port (accessible at http://localhost:3000)
    "port": 3000,
    // Full page reload on file changes
    "reload": true,
    // Hot Module Replacement (HMR) - faster updates without full reload
    "hot": true,
  },

  // Production build configuration for browser
  "build": {
    // Target browser/DOM environment (not Node.js)
    "target": "browser",
    // Output format: ESM (modern JavaScript modules)
    "format": "esm",
    // Minify JavaScript and CSS for production
    "minify": true,
    // Include source maps inline for browser DevTools debugging
    "sourcemap": "inline",
    // Preserve original file names in output bundle
    "entry_naming": "[name].[ext]",
  },
}
