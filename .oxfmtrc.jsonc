/**
 * Oxfmt Configuration
 * Rust-based code formatter for JavaScript, TypeScript, JSX, and other languages
 * Docs: https://oxc.rs/docs/guide/formatter.html
 */
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100, // Maximum line length before wrapping
  "singleQuote": true, // Prefer single quotes ('') over double quotes
  "semi": false, // Do not require semicolons at end of statements
  "arrowParens": "avoid", // Only add parentheses to arrow functions when necessary
  "bracketSpacing": true, // Add spaces inside { } in object literals
  "singleAttributePerLine": false, // Allow multiple JSX attributes on one line
  "ignorePatterns": ["node_modules", "dist", ".git", ".env*", "*.min.js", "*.min.css", "coverage"],
}
