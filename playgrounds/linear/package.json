{
  "name": "@repliql/playground-linear",
  "version": "0.0.1",
  "description": "Linear app playground using URQL GraphQL client",
  "type": "module",
  "scripts": {
    "dev": "bun --hot ./src/index.html",
    "build": "bun build ./src/index.tsx --outdir ./dist --entry-naming [name].[ext] --minify",
    "preview": "bun serve ./dist",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src"
  },
  "dependencies": {
    "@urql/core": "^5.1.1",
    "graphql": "^16.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.5.0",
    "urql": "^4.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "bun-types": "latest",
    "typescript": "^6.0.0"
  }
}
