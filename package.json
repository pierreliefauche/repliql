{
  "name": "repliql",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "./packages/*",
      "./playgrounds/*"
    ]
  },
  "type": "module",
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "changeset": "changeset",
    "dev": "NODE_ENV=development bun run --filter @repliql/playground-linear dev",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "release": "bun run build && bun run ./scripts/release.ts",
    "test": "bun test --config=bunfig.jsonc",
    "test:watch": "bun test --config=bunfig.jsonc --watch",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/bun": "latest",
    "bun-types": "latest",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsdown": "^0.21.10",
    "typescript": "catalog:"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --quiet --relative"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "catalog": {
    "@0no-co/graphql.web": "^1.2.0",
    "@urql/core": "^6.0.1",
    "comlink": "^4.4.2",
    "graphql": "^16.13.2",
    "kysely": "^0.28.16",
    "typescript": "^6.0.2",
    "wonka": "^6.3.6"
  }
}
