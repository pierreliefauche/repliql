{
  "name": "repliql",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "./packages/*",
      "./playgrounds/*"
    ],
    "catalog": {}
  },
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --filter @repliql/playground-linear dev",
    "build": "bun run build:packages",
    "build:packages": "bun run --filter='./packages/*' build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt -c ./.oxfmtrc.jsonc --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^6.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --quiet --relative"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11"
}
