{
  "name": "@repliql/utils",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:esm && bun run build:cjs",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --minify --packages=external",
    "build:esm": "tsc",
    "dev": "tsc --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch"
  },
  "dependencies": {
    "@0no-co/graphql.web": "catalog:",
    "@solana/fast-stable-stringify": "^6.8.0",
    "@urql/core": "catalog:",
    "strict-event-emitter": "^0.5.1"
  },
  "devDependencies": {
    "graphql": "catalog:",
    "wonka": "catalog:"
  }
}
