{
  "name": "@repliql/utils",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch"
  },
  "dependencies": {
    "@0no-co/graphql.web": "catalog:",
    "@solana/fast-stable-stringify": "^6.8.0",
    "@urql/core": "catalog:",
    "strict-event-emitter": "^0.5.1",
    "wonka": "catalog:"
  },
  "devDependencies": {
    "graphql": "catalog:"
  }
}
