{
  "name": "@repliql/shared-exchange",
  "version": "0.0.1",
  "description": "",
  "keywords": [
    "urql"
  ],
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.js",
      "require": "./dist/tab.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repliql/shared-service": "workspace:*"
  },
  "devDependencies": {
    "@repliql/utils": "workspace:*",
    "@urql/core": "catalog:",
    "typescript": "catalog:",
    "wonka": "catalog:"
  },
  "peerDependencies": {
    "@urql/core": ">=5.0.0",
    "comlink": ">=4.0.0",
    "wonka": ">=6.0.0"
  }
}
