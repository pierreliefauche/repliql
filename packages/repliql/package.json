{
  "name": "@repliql/repliql",
  "version": "0.0.1",
  "description": "Offline-first cache and local database extension for URQL",
  "keywords": [
    "cache",
    "database",
    "graphql",
    "offline",
    "typescript",
    "urql"
  ],
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run build:ts && bun run build:types",
    "build:ts": "bun build ./src/index.ts --outdir ./dist --format esm --minify",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "bun build ./src/index.ts --watch --outdir ./dist --format esm",
    "test": "bun test src/**/*.test.ts",
    "test:watch": "bun test src/**/*.test.ts --watch",
    "lint": "oxlint src",
    "fmt": "oxfmt --write src"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "latest",
    "typescript": "^6.0.0"
  }
}
