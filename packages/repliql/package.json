{
  "name": "@repliql/repliql",
  "version": "0.0.1",
  "description": "Offline-first cache and local database extension for URQL",
  "keywords": [
    "cache",
    "database",
    "graphql",
    "offline",
    "typescript",
    "urql"
  ],
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:ts && bun run build:esm && bun run build:cjs && bun run build:types",
    "build:cjs": "bun build ./src/index.ts --outfile ./dist/index.cjs --format cjs --minify --packages=external",
    "build:esm": "bun build ./src/index.ts --outfile ./dist/index.mjs --format esm --minify --packages=external",
    "build:ts": "bun build ./src/index.ts --outdir ./dist --format esm --minify --packages=external",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "bun build ./src/index.ts --watch --outdir ./dist --format esm --packages=external",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch"
  },
  "dependencies": {
    "@0no-co/graphql.web": "catalog:",
    "@repliql/reactive-kysely": "workspace:*",
    "@repliql/utils": "workspace:*",
    "@urql/core": "catalog:",
    "@urql/exchange-execute": "^3.0.0",
    "dataloader": "^2.2.3",
    "kysely": "catalog:",
    "wonka": "catalog:"
  },
  "devDependencies": {},
  "peerDependencies": {}
}
