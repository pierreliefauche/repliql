{
  "name": "@repliql/repliql",
  "version": "0.0.1",
  "description": "Offline-first cache and local database extension for URQL",
  "keywords": [
    "cache",
    "database",
    "graphql",
    "offline",
    "typescript",
    "urql"
  ],
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch"
  },
  "dependencies": {
    "@0no-co/graphql.web": "catalog:",
    "@repliql/reactive-kysely": "workspace:*",
    "@repliql/utils": "workspace:*",
    "@urql/core": "catalog:",
    "@urql/exchange-execute": "^3.0.0",
    "dataloader": "^2.2.3",
    "kysely": "catalog:",
    "wonka": "catalog:"
  },
  "devDependencies": {},
  "peerDependencies": {}
}
