{
  "name": "@repliql/reactive-kysely",
  "version": "0.1.0",
  "description": "",
  "keywords": [
    "kysely"
  ],
  "license": "MIT",
  "author": "RepliQL Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/pierreliefauche/repliql",
    "directory": "packages/reactive-kysely"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repliql/utils": "workspace:*",
    "wonka": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "node-sqlite3-wasm": "^0.8.56",
    "react": "^19.2.4"
  },
  "peerDependencies": {
    "kysely": "catalog:",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
