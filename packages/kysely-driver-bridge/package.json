{
  "name": "@repliql/kysely-driver-bridge",
  "version": "0.1.0",
  "description": "Bridge a Kysely driver across processes via Comlink",
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dedicated": {
      "types": "./dist/dedicated.d.ts",
      "import": "./dist/dedicated.js",
      "require": "./dist/dedicated.cjs"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.js",
      "require": "./dist/tab.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repliql/conduit": "workspace:*",
    "@repliql/utils": "workspace:*"
  },
  "devDependencies": {
    "node-sqlite3-wasm": "^0.8.56",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "comlink": "catalog:",
    "kysely": "catalog:"
  }
}
