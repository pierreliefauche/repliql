{
  "name": "@repliql/shared-service",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js",
      "require": "./dist/shared.cjs"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.js",
      "require": "./dist/tab.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repliql/utils": "workspace:*"
  },
  "devDependencies": {
    "comlink": "catalog:",
    "typescript": "catalog:"
  }
}
