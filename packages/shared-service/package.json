{
  "name": "@repliql/shared-service",
  "version": "0.0.1",
  "description": "",
  "license": "MIT",
  "author": "RepliQL Contributors",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.mjs",
      "require": "./dist/shared.cjs"
    },
    "./tab": {
      "types": "./dist/tab.d.ts",
      "import": "./dist/tab.mjs",
      "require": "./dist/tab.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:shared && bun run build:tab && bun run build:types",
    "build:shared": "bun build ./src/shared.ts --outfile ./dist/shared.mjs --format esm --minify && bun build ./src/shared.ts --outfile ./dist/shared.cjs --format cjs --minify",
    "build:tab": "bun build ./src/tab.ts --outfile ./dist/tab.mjs --format esm --minify && bun build ./src/tab.ts --outfile ./dist/tab.cjs --format cjs --minify",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap",
    "dev": "bun build ./src/shared.ts ./src/tab.ts --watch --outdir ./dist --format esm",
    "fmt": "oxfmt --write src",
    "lint": "oxlint src",
    "test": "bun test ./src/**/*.test.ts ./src/*.test.ts",
    "test:watch": "bun test ./src/**/*.test.ts ./src/*.test.ts --watch"
  },
  "dependencies": {
    "@repliql/utils": "workspace:*"
  },
  "devDependencies": {
    "comlink": "catalog:",
    "typescript": "catalog:"
  }
}
