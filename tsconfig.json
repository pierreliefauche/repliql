{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "incremental": true,
    "resolveJsonModule": true, // Allow importing .json files as modules
    "allowJs": false, // Allow .js files in the project
    "checkJs": false, // Don't perform type checking on .js files
    "jsx": "react-jsx", // Use React 17+ JSX transform
    "strict": true, // Enable all strict type checking options
    "noImplicitAny": true, // Require explicit types (no implicit 'any')
    "strictNullChecks": true, // Treat null/undefined separately
    "strictFunctionTypes": true, // Strict checking of function types
    "strictPropertyInitialization": true, // Class properties must be initialized
    "noImplicitThis": true, // Error on 'this' with no explicit type
    "alwaysStrict": true, // Parse in strict mode
    "noUnusedLocals": true, // Flag unused local variables as errors
    "noUnusedParameters": true, // Flag unused function parameters as errors
    "noImplicitReturns": true, // Error if functions don't return on all paths
    "noFallthroughCasesInSwitch": true, // Flag missing break in switch cases
    "declaration": true, // Generate .d.ts type definition files
    "declarationMap": true, // Generate source maps for .d.ts files
    "sourceMap": true, // Generate .js.map source maps
    "outDir": "./dist", // Output directory for compiled files
    "rootDir": "./", // Root source directory
    "paths": {
      "@repliql/*": ["./packages/*/src"] // Path aliases: @repliql/pkg → packages/pkg/src
    },
    "types": ["bun-types"] // Include Bun runtime type definitions
  },
  "include": [
    "packages/*/src/**/*", // All package source files
    "playground/src/**/*", // Playground application source
    "scripts/**/*" // Build and utility scripts
  ],
  "exclude": [
    "node_modules", // Exclude dependencies
    "dist", // Exclude build output
    "**/node_modules", // Exclude nested node_modules
    "**/dist", // Exclude nested build output
    "**/*.test.ts", // Exclude TypeScript test files
    "**/*.test.tsx" // Exclude React test files
  ]
}
